{
  "name": "what-the-node",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "See which node/bun/deno processes are actually running on your machine — filters out Electron/desktop-app noise and shows where each one came from.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-set-before-publish/what-the-node.git"
  },
  "bin": {
    "what-the-node": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "lint": "eslint --fix src",
    "format": "prettier --write -l src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsdown src/cli.ts --format esm --clean",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "execa": "^8.0.1",
    "ps-list": "^9.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "@xola/jslint": "^4.0.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "semi": true,
    "printWidth": 120,
    "trailingComma": "all",
    "singleQuote": false,
    "bracketSpacing": true,
    "useTabs": false,
    "arrowParens": "always",
    "bracketSameLine": false,
    "tabWidth": 4,
    "importOrder": [
      "^[./]",
      "^@/(.*)$"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "overrides": [
      {
        "files": [
          "*.json",
          "*.yaml",
          "*.yml"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  },
  "packageManager": "pnpm@10.34.1"
}
