{
  "name": "what-the-node",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "See which node/bun/deno processes are actually running on your machine — filters out Electron/desktop-app noise and shows where each one came from.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TODO-set-before-publish/what-the-node.git"
  },
  "bin": {
    "what-the-node": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/cli.ts --format esm --clean && chmod +x dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "ps-list": "^9.0.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.2",
    "@xola/jslint": "^4.0.1",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "type-fest": "^5.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "prettier": {
    "semi": true,
    "printWidth": 120,
    "trailingComma": "all",
    "singleQuote": false,
    "bracketSpacing": true,
    "useTabs": false,
    "arrowParens": "always",
    "bracketSameLine": false,
    "tabWidth": 4,
    "importOrder": [
      "^[./]",
      "^@/(.*)$"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ],
    "overrides": [
      {
        "files": [
          "*.json",
          "*.yaml",
          "*.yml"
        ],
        "options": {
          "tabWidth": 2
        }
      }
    ]
  },
  "packageManager": "pnpm@10.34.1"
}
